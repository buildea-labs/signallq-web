+              {current.diagnostic.conclusion}
+            </h2>
+            <p className="mt-2 mb-0 font-normal text-[14px] leading-[1.45] text-[color:var(--text-secondary)]">
+              {current.diagnostic.confidence}
+            </p>
+          </>
